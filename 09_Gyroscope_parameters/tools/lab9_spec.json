   "y": 1140,
   "props": {
    "Body": "-- elapsed seconds inside this phase\nt = (time() - t0) / 1000\n-- amplitude 30 -> 60 -> 150 % at t = 12 s and t = 24 s\nA = 30 + 15 * (sgn(t - 12) + 1) + 45 * (sgn(t - 24) + 1)\nu = A * sgn(sin(2 * pi * t / 4))\n-- clip to the motor limit: 150 % becomes 100 %\nu = max(-100, min(100, u))"
   }
  },
  {
   "id": "rect_m3",
   "type": "TrikV6EnginesForward",
   "x": 600,
   "y": 1140,
   "props": {
    "Ports": "M3",
    "Power": "u"
   }
  },
  {
   "id": "rect_m4",
   "type": "TrikV6EnginesBackward",
   "x": 750,
   "y": 1140,
   "props": {
    "Ports": "M4",
    "Power": "u"
   }
  },
  {
   "id": "rect_raw",
   "type": "TrikSystem",
   "x": 900,
   "y": 1140,
   "props": {
    "Code": "true",
    "Evaluate": "false",
    "Command": "gzraw = brick.gyroscope().readRawData()[2];"
   }
  },
  {
   "id": "rect_g",
