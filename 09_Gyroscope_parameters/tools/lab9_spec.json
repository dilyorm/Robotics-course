{
 "blocks": [
  {
   "id": "start",
   "type": "InitialNode",
   "x": 0,
   "y": 0,
   "props": {}
  },
  {
   "id": "init",
   "type": "Function",
   "x": 150,
   "y": 0,
   "props": {
    "Body": "-- geometry from Lab 5, used offline in the notebook\n-- r = 0.042 m, B = 0.194 m\nphase = \"init\"\nu = 0\nt = 0\nt0 = 0\nA = 0\nn = 0\nbuf = \"\"\ngzcal = 0\ngzraw = 0\ntus = 0\n-- CSV header line, written once\nline = \"# t_us,phase,u,gz_cal,gz_raw,encL,encR\\n\""
   }
  },
  {
   "id": "rm",
   "type": "TrikRemoveFile",
   "x": 300,
   "y": 0,
   "props": {
    "File": "lab9_gyro.csv"
   }
  },
  {
   "id": "hdr",
   "type": "TrikWriteToFile",
   "x": 450,
   "y": 0,
   "props": {
    "File": "lab9_gyro.csv",
    "Text": "line"
   }
  },
  {
   "id": "clr",
   "type": "TrikV62ClearEncoder",
   "x": 600,
   "y": 0,
   "props": {
    "Ports": "E3, E4"
   }
  },
  {
   "id": "p_warm",
   "type": "TrikPrintText",
   "x": 750,
   "y": 0,
   "props": {
    "PrintText": "warmup",
    "FontSize": "20"
   }
  },
  {
   "id": "t_warm",
   "type": "Timer",
   "x": 900,
   "y": 0,
   "props": {
    "Delay": "120000"
   }
  },
  {
   "id": "c_init",
   "type": "CommentBlock",
   "x": 0,
   "y": -140,
   "props": {
    "Comment": "phase  - phase label in every CSV line\nu      - wheel power, % (left gets -u)\nt      - seconds since phase start\nt0     - phase start, ms\nA      - rotation amplitude, %\nn      - samples waiting in buf\nbuf    - CSV lines not yet written"
   }
  },
  {
   "id": "c_rm",
   "type": "CommentBlock",
   "x": 480,
   "y": -140,
   "props": {
    "Comment": "Write To File appends, so the old log goes first.\nThe file lands in the robot's scripts folder."
   }
  },
  {
   "id": "c_warm",
   "type": "CommentBlock",
   "x": 920,
   "y": -140,
   "props": {
    "Comment": "2 min, motors off, not logged.\nA MEMS gyro needs thermal equilibrium\nbefore its offset is stable."
   }
  },
  {
   "id": "static_print",
   "type": "TrikPrintText",
   "x": 0,
   "y": 380,
   "props": {
    "PrintText": "static 3 min",
    "FontSize": "20"
   }
  },
  {
   "id": "static_init",
   "type": "Function",
   "x": 150,
   "y": 380,
   "props": {
    "Body": "phase = \"static\"\n-- remember when this phase started\nt0 = time()"
   }
  },
  {
   "id": "static_loop",
   "type": "PreconditionalLoop",
   "x": 300,
   "y": 380,
   "props": {
    "Condition": "time() - t0 < 180000"
   }
  },
  {
   "id": "static_raw",
   "type": "TrikSystem",
   "x": 450,
   "y": 380,
   "props": {
    "Code": "true",
    "Evaluate": "false",
    "Command": "gzraw = brick.gyroscope().readRawData()[2];"
   }
  },
  {
   "id": "static_g",
   "type": "Function",
   "x": 600,
   "y": 380,
   "props": {
    "Body": "-- rate in mdeg/s and the sensor timestamp in us\ngzcal = gyroscope[2]\ntus = time() * 1000"
   }
  },
  {
   "id": "static_line",
   "type": "Function",
   "x": 750,
   "y": 380,
   "props": {
    "Body": "-- one CSV line: t_us,phase,u,gz_cal,gz_raw,encL,encR\nline = tus .. \",\" .. phase .. \",\" .. u .. \",\" .. gzcal .. \",\" .. gzraw .. \",\" .. encoder4 .. \",\" .. encoder3 .. \"\\n\"\n-- keep it in memory; the card is written in blocks\nbuf = buf .. line\nn = n + 1"
   }
  },
  {
   "id": "static_if",
   "type": "IfBlock",
   "x": 900,
   "y": 380,
   "props": {
    "Condition": "n >= 200"
   }
  },
  {
   "id": "static_timer",
   "type": "Timer",
   "x": 1050,
   "y": 380,
   "props": {
    "Delay": "10"
   }
  },
  {
   "id": "static_write",
   "type": "TrikWriteToFile",
   "x": 900,
   "y": 530,
   "props": {
    "File": "lab9_gyro.csv",
    "Text": "buf"
   }
  },
  {
   "id": "static_reset",
   "type": "Function",
   "x": 1050,
   "y": 530,
   "props": {
    "Body": "-- the block is on the card, start a new buffer\nbuf = \"\"\nn = 0"
   }
  },
  {
   "id": "static_fi",
   "type": "FiBlock",
   "x": 1200,
   "y": 570,
   "props": {}
  },
  {
   "id": "static_note",
   "type": "CommentBlock",
   "x": 0,
   "y": 310,
   "props": {
    "Comment": "STATIC LOG - 3 min, motors off"
   }
  },
  {
   "id": "static_extra0",
   "type": "CommentBlock",
   "x": 150,
   "y": 620,
   "props": {
    "Comment": "One sample every ~10 ms. Every 200 samples the buffer is\nwritten to the card in one go, so file I/O does not stretch\nthe sampling period."
   }
  },
  {
   "id": "static_extra1",
   "type": "CommentBlock",
   "x": 750,
   "y": 620,
   "props": {
    "Comment": "Gives the offset b0, the drift d,\nthe resolution and the noise sigma."
   }
  },
  {
   "id": "sin_print",
   "type": "TrikPrintText",
   "x": 0,
   "y": 760,
   "props": {
    "PrintText": "sin 36 s",
    "FontSize": "20"
   }
  },
  {
   "id": "sin_init",
   "type": "Function",
   "x": 150,
   "y": 760,
   "props": {
    "Body": "phase = \"sin\"\n-- remember when this phase started\nt0 = time()"
   }
  },
  {
   "id": "sin_loop",
   "type": "PreconditionalLoop",
   "x": 300,
   "y": 760,
   "props": {
    "Condition": "time() - t0 < 36000"
   }
  },
  {
   "id": "sin_u",
   "type": "Function",
   "x": 450,
   "y": 760,
   "props": {
    "Body": "-- elapsed seconds inside this phase\nt = (time() - t0) / 1000\n-- amplitude 30 -> 60 -> 150 % at t = 12 s and t = 24 s\nA = 30 + 15 * (sgn(t - 12) + 1) + 45 * (sgn(t - 24) + 1)\nu = A * sin(2 * pi * t / 4)\n-- clip to the motor limit: 150 % becomes 100 %\nu = max(-100, min(100, u))"
   }
  },
  {
   "id": "sin_m3",
   "type": "TrikV6EnginesForward",
   "x": 600,
   "y": 760,
   "props": {
    "Ports": "M3",
    "Power": "u"
   }
  },
  {
   "id": "sin_m4",
   "type": "TrikV6EnginesBackward",
   "x": 750,
   "y": 760,
   "props": {
    "Ports": "M4",
    "Power": "u"
   }
  },
  {
   "id": "sin_raw",
   "type": "TrikSystem",
   "x": 900,
   "y": 760,
   "props": {
    "Code": "true",
    "Evaluate": "false",
    "Command": "gzraw = brick.gyroscope().readRawData()[2];"
   }
  },
  {
   "id": "sin_g",
   "type": "Function",
   "x": 1050,
   "y": 760,
   "props": {
    "Body": "-- rate in mdeg/s and the sensor timestamp in us\ngzcal = gyroscope[2]\ntus = time() * 1000"
   }
  },
  {
   "id": "sin_line",
   "type": "Function",
   "x": 1200,
   "y": 760,
   "props": {
    "Body": "-- one CSV line: t_us,phase,u,gz_cal,gz_raw,encL,encR\nline = tus .. \",\" .. phase .. \",\" .. u .. \",\" .. gzcal .. \",\" .. gzraw .. \",\" .. encoder4 .. \",\" .. encoder3 .. \"\\n\"\n-- keep it in memory; the card is written in blocks\nbuf = buf .. line\nn = n + 1"
   }
  },
  {
   "id": "sin_if",
   "type": "IfBlock",
   "x": 1350,
   "y": 760,
   "props": {
    "Condition": "n >= 200"
   }
  },
  {
   "id": "sin_timer",
   "type": "Timer",
   "x": 1500,
   "y": 760,
   "props": {
    "Delay": "10"
   }
  },
  {
   "id": "sin_write",
   "type": "TrikWriteToFile",
   "x": 1350,
   "y": 910,
   "props": {
    "File": "lab9_gyro.csv",
    "Text": "buf"
   }
  },
  {
   "id": "sin_reset",
   "type": "Function",
   "x": 1500,
   "y": 910,
   "props": {
    "Body": "-- the block is on the card, start a new buffer\nbuf = \"\"\nn = 0"
   }
  },
  {
   "id": "sin_fi",
   "type": "FiBlock",
   "x": 1650,
   "y": 950,
   "props": {}
  },
  {
   "id": "sin_note",
   "type": "CommentBlock",
   "x": 0,
   "y": 690,
   "props": {
    "Comment": "SINE ROTATION - in place, period 4 s"
   }
  },
  {
   "id": "sin_extra0",
   "type": "CommentBlock",
   "x": 750,
   "y": 1000,
   "props": {
    "Comment": "In-place turn: right wheel +u, left wheel -u.\n150 % is clipped to 100 %, so the last 12 s run at\nmaximum rate and the gyro saturates - that is how the\nmeasurement range is found (section 3)."
   }
  },
  {
   "id": "rect_print",
   "type": "TrikPrintText",
   "x": 0,
   "y": 1140,
   "props": {
    "PrintText": "rect 36 s",
    "FontSize": "20"
   }
  },
  {
   "id": "rect_init",
   "type": "Function",
   "x": 150,
   "y": 1140,
   "props": {
    "Body": "phase = \"rect\"\n-- remember when this phase started\nt0 = time()"
   }
  },
  {
