   }
  },
  {
   "id": "rest_fi",
   "type": "FiBlock",
   "x": 1200,
   "y": 1710,
   "props": {}
  },
  {
   "id": "rest_note",
   "type": "CommentBlock",
   "x": 0,
   "y": 1450,
   "props": {
    "Comment": "REST - 3 s at standstill, logged"
   }
  },
  {
   "id": "rest_extra0",
   "type": "CommentBlock",
   "x": 150,
   "y": 1760,
   "props": {
    "Comment": "So the final gyro and encoder angles can be compared with\nthe robot not moving."
   }
  },
  {
   "id": "stop",
   "type": "TrikV6EnginesStop",
   "x": 0,
   "y": 1940,
   "props": {
    "Ports": "M3, M4",
    "Mode": "float"
   }
  },
  {
   "id": "flush",
   "type": "TrikWriteToFile",
   "x": 150,
   "y": 1940,
   "props": {
    "File": "lab9_gyro.csv",
    "Text": "buf"
   }
  },
  {
   "id": "sync",
   "type": "TrikSystem",
   "x": 300,
   "y": 1940,
   "props": {
    "Code": "true",
    "Evaluate": "false",
    "Command": "script.system(\"sync\", true);"
   }
  },
  {
   "id": "p_done",
   "type": "TrikPrintText",
   "x": 450,
   "y": 1940,
   "props": {
    "PrintText": "done",
    "FontSize": "20"
   }
  },
  {
   "id": "end",
   "type": "FinalNode",
   "x": 600,
   "y": 1940,
   "props": {}
  },
  {
   "id": "c_end",
   "type": "CommentBlock",
   "x": 750,
   "y": 1940,
   "props": {
    "Comment": "Stop the motors, write the last partial buffer, then sync so\nthe file survives a power-off.\nCopy lab9_gyro.csv off the robot and run the notebook."
   }
  }
