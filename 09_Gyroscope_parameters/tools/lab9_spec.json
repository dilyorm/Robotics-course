   }
  },
  {
   "id": "rect_timer",
   "type": "Timer",
   "x": 1500,
   "y": 1140,
   "props": {
    "Delay": "10"
   }
  },
  {
   "id": "rect_write",
   "type": "TrikWriteToFile",
   "x": 1350,
   "y": 1290,
   "props": {
    "File": "lab9_gyro.csv",
    "Text": "buf"
   }
  },
  {
   "id": "rect_reset",
   "type": "Function",
   "x": 1500,
   "y": 1290,
   "props": {
    "Body": "-- the block is on the card, start a new buffer\nbuf = \"\"\nn = 0"
   }
  },
  {
   "id": "rect_fi",
   "type": "FiBlock",
   "x": 1650,
   "y": 1330,
   "props": {}
  },
  {
   "id": "rect_note",
   "type": "CommentBlock",
   "x": 0,
   "y": 1070,
   "props": {
    "Comment": "SQUARE ROTATION - in place, period 4 s"
   }
  },
  {
   "id": "rect_extra0",
   "type": "CommentBlock",
   "x": 750,
   "y": 1380,
   "props": {
    "Comment": "Same amplitudes as the sine, but the robot spends most of\nthe time at full turn rate - shows whether the scale\nfactor holds at high rate (section 6)."
   }
  },
  {
   "id": "rest_print",
   "type": "TrikPrintText",
   "x": 0,
   "y": 1520,
   "props": {
    "PrintText": "rest 3 s",
    "FontSize": "20"
   }
  },
  {
   "id": "rest_init",
   "type": "Function",
   "x": 150,
   "y": 1520,
   "props": {
    "Body": "phase = \"rest\"\n-- remember when this phase started\nt0 = time()"
   }
  },
  {
   "id": "rest_loop",
   "type": "PreconditionalLoop",
   "x": 300,
   "y": 1520,
   "props": {
    "Condition": "time() - t0 < 3000"
   }
  },
  {
   "id": "rest_raw",
   "type": "TrikSystem",
   "x": 450,
   "y": 1520,
   "props": {
    "Code": "true",
    "Evaluate": "false",
    "Command": "gzraw = brick.gyroscope().readRawData()[2];"
   }
  },
  {
   "id": "rest_g",
   "type": "Function",
   "x": 600,
   "y": 1520,
   "props": {
    "Body": "-- rate in mdeg/s and the sensor timestamp in us\ngzcal = gyroscope[2]\ntus = time() * 1000"
   }
